# Copy this file to .env and fill in real values. Never commit .env itself.

# Google Maps SDK — used for map rendering (react-native-maps) and,
# if enabled on the Google Cloud project, Directions/Distance Matrix/Geocoding.
GOOGLE_MAPS_API_KEY=

# Rails backend base URL — must include the /api/v1 prefix, e.g.
# https://your-app.onrender.com/api/v1 (the API is mounted there, not at root)
API_BASE_URL=

# Local Python RAG voice-assistant service (sahulat-rag, FastAPI on :8000).
# This is a separate service from the Rails backend above — no session
# cookie is sent to it. Runs on your dev machine, not a cloud host, so the
# right value depends on where the app is running:
#   iOS Simulator      -> http://localhost:8000
#   Android Emulator    -> http://10.0.2.2:8000
#   Physical device      -> http://<your-machine's-LAN-IP>:8000 (same Wi-Fi)
RAG_API_BASE_URL=

# Firebase Cloud Messaging only — push notifications for job requests/status.
# No Realtime Database: live location goes through the Rails API via polling.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
